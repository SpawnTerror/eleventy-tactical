<h1>CS2 Autoexec Config Generator</h1>
<p>Select your preferences below, preview the generated commands live, and download a ready-to-use <code>autoexec.cfg</code> for Counter-Strike 2. Save it to <code>...\Counter-Strike Global Offensive\game\csgo\cfg\autoexec.cfg</code>.</p>

<form id="autoexec-form" onsubmit="return false;">
  <div class="panel">
    <h2>Network rate</h2>
    <label class="field-label">
      Connection speed (test on <a href="https://fast.com" target="_blank" rel="noopener noreferrer">fast.com</a>)
      <select id="cfg-rate" class="field-select">
        <option value="786432" selected>6.2 Mbps+ — rate 786432 (Recommended)</option>
        <option value="750000">6.0 Mbps — rate 750000</option>
        <option value="687500">5.5 Mbps — rate 687500</option>
        <option value="625000">5.0 Mbps — rate 625000</option>
        <option value="562500">4.5 Mbps — rate 562500</option>
        <option value="500000">4.0 Mbps — rate 500000</option>
        <option value="437500">3.5 Mbps — rate 437500</option>
        <option value="375000">3.0 Mbps — rate 375000</option>
        <option value="312500">2.5 Mbps — rate 312500</option>
        <option value="250000">2.0 Mbps — rate 250000</option>
        <option value="196608">1.57 Mbps — rate 196608</option>
        <option value="187500">1.5 Mbps — rate 187500</option>
        <option value="125000">1.0 Mbps — rate 125000</option>
        <option value="62500">0.5 Mbps — rate 62500</option>
      </select>
    </label>
  </div>

  <div class="panel">
    <h2>Mouse &amp; sensitivity</h2>
    <label class="check-row">
      <input type="checkbox" id="cfg-sens-enable" checked>
      <span>Include mouse sensitivity in autoexec</span>
    </label>
    <div class="field-grid" style="margin-top: 0.5rem;">
      <label class="field-label">
        Mouse DPI
        <input type="number" id="cfg-dpi" class="field-input" value="800" min="100" max="16000" step="50">
      </label>
      <label class="field-label">
        In-game sensitivity
        <input type="number" id="cfg-sens" class="field-input" value="1.15" min="0.05" max="20" step="0.01">
      </label>
      <label class="field-label">
        Zoom sensitivity ratio
        <input type="number" id="cfg-zoom" class="field-input" value="1.0" min="0.1" max="3" step="0.05">
      </label>
    </div>
    <p style="margin: 0.75rem 0 0; font-size: 0.85rem;">Effective DPI: <span class="edpi-pill" id="edpi-display">920 eDPI</span></p>
  </div>

  <div class="panel">
    <h2>Movement &amp; keybinds</h2>
    <div class="field-grid" style="margin-bottom: 0.65rem;">
      <label class="field-label">
        Jump bind
        <select id="cfg-jump" class="field-select">
          <option value="mwheeldown" selected>Space + Mouse Wheel Down</option>
          <option value="mwheelup">Space + Mouse Wheel Up</option>
          <option value="both">Space + Wheel Up &amp; Down</option>
          <option value="space">Space only (default)</option>
        </select>
      </label>
      <label class="field-label">
        Voice chat key
        <select id="cfg-mic" class="field-select">
          <option value="v" selected>V key (bind v +voicerecord)</option>
          <option value="k">K key (default)</option>
          <option value="mouse4">Mouse 4 (side button)</option>
          <option value="none">Do not change</option>
        </select>
      </label>
    </div>
    <label class="check-row">
      <input type="checkbox" id="cfg-loadout" checked>
      <span>Always show inventory &amp; ammo loadout (<code>unbind i; cl_showloadout 1</code>)</span>
    </label>
  </div>

  <div class="panel">
    <h2>Radar &amp; minimap</h2>
    <div class="field-grid" style="margin-bottom: 0.65rem;">
      <label class="field-label">
        Radar map zoom (<code>cl_radar_scale</code>: <strong id="radar-scale-val">0.4</strong>)
        <input type="range" id="cfg-radar-scale" min="0.25" max="1.0" step="0.05" value="0.4">
      </label>
      <label class="field-label">
        HUD radar size (<code>cl_hud_radar_scale</code>: <strong id="hud-radar-val">1.1</strong>)
        <input type="range" id="cfg-hud-radar" min="0.8" max="1.3" step="0.05" value="1.1">
      </label>
    </div>
    <label class="check-row">
      <input type="checkbox" id="cfg-radar-center" checked>
      <span>Keep full map visible instead of centring on player (<code>cl_radar_always_centered 0</code>)</span>
    </label>
    <label class="check-row">
      <input type="checkbox" id="cfg-radar-colors" checked>
      <span>Show teammates in distinct colours on radar (<code>cl_teammate_colors_show 1</code>)</span>
    </label>
    <label class="check-row">
      <input type="checkbox" id="cfg-radar-icons" checked>
      <span>Set minimum player icon scale to 1 (<code>cl_radar_icon_scale_min 1</code>)</span>
    </label>
  </div>

  <div class="panel">
    <h2>Performance, HUD &amp; audio</h2>
    <div class="field-grid" style="margin-bottom: 0.65rem;">
      <label class="field-label">
        Max FPS (<code>0</code> = uncapped)
        <input type="number" id="cfg-fps" class="field-input" value="0" min="0" max="1000" step="10">
      </label>
      <label class="field-label">
        Crosshair preset
        <select id="cfg-xhair" class="field-select">
          <option value="none" selected>Keep my existing crosshair</option>
          <option value="greendot">Static Green Dot (Tactical preset)</option>
        </select>
      </label>
    </div>
    <label class="check-row">
      <input type="checkbox" id="cfg-console" checked>
      <span>Enable developer console (<code>con_enable 1</code>)</span>
    </label>
    <label class="check-row">
      <input type="checkbox" id="cfg-instructor" checked>
      <span>Disable game instructor hints (<code>gameinstructor_enable 0</code>)</span>
    </label>
    <label class="check-row">
      <input type="checkbox" id="cfg-join" checked>
      <span>Allow friends to join any server (<code>cl_join_advertise 2</code>)</span>
    </label>
    <label class="check-row">
      <input type="checkbox" id="cfg-targetid" checked>
      <span>Display enemy names on crosshair hover (<code>hud_showtargetid 1</code>)</span>
    </label>
    <label class="check-row">
      <input type="checkbox" id="cfg-friendly" checked>
      <span>Show friendly-fire crosshair warning (<code>cl_crosshair_friendly_warning 1</code>)</span>
    </label>
    <label class="check-row">
      <input type="checkbox" id="cfg-telemetry" checked>
      <span>Enable CS2 telemetry (FPS, frametime, ping, and network graph)</span>
    </label>
    <label class="check-row">
      <input type="checkbox" id="cfg-music" checked>
      <span>Mute all in-game music except the 10-second bomb defuse warning</span>
    </label>
  </div>
</form>

<div class="panel">
  <h2>Generated <code>autoexec.cfg</code></h2>
  <div class="action-bar">
    <button type="button" id="btn-download" class="btn">Download autoexec.cfg</button>
    <button type="button" id="btn-copy" class="btn btn-secondary">Copy to clipboard</button>
  </div>
  <textarea id="cfg-output" class="cfg-output" readonly spellcheck="false"></textarea>
</div>

<div class="tip-callout callout-info">
  <span class="tip-title"><span>How to load autoexec.cfg automatically</span></span>
  <p>Add <code>+exec autoexec.cfg</code> to your CS2 launch options in Steam, or type <code>exec autoexec</code> in the console. See also our <a href="/best-cs2-launch-options-for-2024-boost-fps-performance/">CS2 launch options guide</a> and <a href="/practice-config/">practice.cfg</a>.</p>
</div>

<script>
(function() {
  const $ = id => document.getElementById(id);

  function buildConfig() {
    const dpi = parseFloat($('cfg-dpi').value) || 800;
    const sens = parseFloat($('cfg-sens').value) || 1.15;
    const zoom = parseFloat($('cfg-zoom').value) || 1.0;
    const edpi = Math.round(dpi * sens);
    $('edpi-display').textContent = `${edpi} eDPI`;

    const radarScale = $('cfg-radar-scale').value;
    const hudRadar = $('cfg-hud-radar').value;
    $('radar-scale-val').textContent = radarScale;
    $('hud-radar-val').textContent = hudRadar;

    const lines = [
      '// Counter-Strike 2 autoexec.cfg',
      '// Generated at {{ site.url }}/autoexec-generator/',
      '',
      '// --- Network ---',
      `rate "${$('cfg-rate').value}"`,
      '',
      '// --- General ---',
      `fps_max "${parseInt($('cfg-fps').value, 10) || 0}"`
    ];

    if ($('cfg-console').checked) lines.push('con_enable "1"');
    if ($('cfg-instructor').checked) lines.push('gameinstructor_enable "0"');
    if ($('cfg-join').checked) lines.push('cl_join_advertise "2"');

    if ($('cfg-sens-enable').checked) {
      lines.push('', '// --- Mouse ---');
      lines.push(`// ${dpi} DPI x ${sens} = ${edpi} eDPI`);
      lines.push(`sensitivity "${sens}"`);
      lines.push(`zoom_sensitivity_ratio "${zoom}"`);
    }

    lines.push('', '// --- Movement & Binds ---');
    const jump = $('cfg-jump').value;
    lines.push('bind "space" "+jump"');
    if (jump === 'mwheeldown' || jump === 'both') lines.push('bind "mwheeldown" "+jump"');
    if (jump === 'mwheelup' || jump === 'both') lines.push('bind "mwheelup" "+jump"');

    const mic = $('cfg-mic').value;
    if (mic !== 'none') lines.push(`bind "${mic}" "+voicerecord"`);
    if ($('cfg-loadout').checked) {
      lines.push('unbind "i"');
      lines.push('cl_showloadout "1"');
    }

    lines.push('', '// --- Radar ---');
    lines.push(`cl_radar_scale "${radarScale}"`);
    lines.push(`cl_hud_radar_scale "${hudRadar}"`);
    if ($('cfg-radar-center').checked) lines.push('cl_radar_always_centered "0"');
    if ($('cfg-radar-colors').checked) lines.push('cl_teammate_colors_show "1"');
    if ($('cfg-radar-icons').checked) lines.push('cl_radar_icon_scale_min "1"');

    lines.push('', '// --- HUD & Telemetry ---');
    if ($('cfg-targetid').checked) lines.push('hud_showtargetid "1"');
    if ($('cfg-friendly').checked) lines.push('cl_crosshair_friendly_warning "1"');
    if ($('cfg-telemetry').checked) {
      lines.push('cl_hud_telemetry_frametime_show "2"');
      lines.push('cl_hud_telemetry_ping_show "2"');
      lines.push('cl_hud_telemetry_net_misdelivery_show "2"');
      lines.push('cl_hud_telemetry_net_quality_graph_show "2"');
      lines.push('r_show_build_info "1"');
    }

    if ($('cfg-xhair').value === 'greendot') {
      lines.push('', '// --- Crosshair (Static Green Dot) ---');
      lines.push('cl_crosshairstyle "4"');
      lines.push('cl_crosshairdot "1"');
      lines.push('cl_crosshairsize "0"');
      lines.push('cl_crosshairthickness "1.5"');
      lines.push('cl_crosshair_drawoutline "1"');
      lines.push('cl_crosshair_outlinethickness "1"');
      lines.push('cl_crosshaircolor "1"');
      lines.push('cl_crosshairalpha "255"');
    }

    if ($('cfg-music').checked) {
      lines.push('', '// --- Audio (10-second bomb warning only) ---');
      lines.push('snd_menumusic_volume "0"');
      lines.push('snd_roundstart_volume "0"');
      lines.push('snd_roundend_volume "0"');
      lines.push('snd_mapobjective_volume "0"');
      lines.push('snd_deathcamera_volume "0"');
      lines.push('snd_mvp_volume "0"');
      lines.push('snd_tensecondwarning_volume "0.2"');
    }

    lines.push('', 'host_writeconfig', 'echo "Tactical CS2 autoexec.cfg loaded!"', '');
    $('cfg-output').value = lines.join('\n');
  }

  $('autoexec-form').addEventListener('input', buildConfig);
  $('autoexec-form').addEventListener('change', buildConfig);
  buildConfig();

  $('btn-download').addEventListener('click', () => {
    const blob = new Blob([$('cfg-output').value], { type: 'text/plain;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'autoexec.cfg';
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  });

  $('btn-copy').addEventListener('click', () => {
    const text = $('cfg-output').value;
    const btn = $('btn-copy');
    const done = () => {
      btn.textContent = 'Copied!';
      setTimeout(() => { btn.textContent = 'Copy to clipboard'; }, 2000);
    };
    if (navigator.clipboard && window.isSecureContext) {
      navigator.clipboard.writeText(text).then(done);
    } else {
      $('cfg-output').select();
      document.execCommand('copy');
      done();
    }
  });
})();
</script>
